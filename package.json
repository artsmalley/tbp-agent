{
    "name": "tbp-coach-teams",
    "version": "1.2.0",
    "msteams": {
        "teamsAppId": null
    },
    "description": "TBP Coach for Microsoft Teams — Toyota Business Practices 8-step problem-solving coach, built on the Microsoft 365 Agents SDK",
    "author": "Art Smalley",
    "license": "MIT",
    "main": "./lib/src/index.js",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
        "dev:teamsfx:playground": "env-cmd --silent -f .localConfigs.playground npm run dev",
        "dev:teamsfx:launch-playground": "env-cmd --silent -f env/.env.playground agentsplayground start",
        "dev": "nodemon --exec node --inspect=9239 --signal SIGINT -r ts-node/register ./src/index.ts",
        "build": "tsc --build",
        "start": "node ./lib/src/index.js",
        "test": "npm run build && node --test tests/*.test.cjs",
        "watch": "nodemon --exec \"npm run start\""
    },
    "repository": {
        "type": "git",
        "url": "https://github.com"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.57.0",
        "@microsoft/agents-hosting-express": "^1.0.0",
        "openai": "^6.48.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "env-cmd": "^10.1.0",
        "nodemon": "^3.1.10",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
}
