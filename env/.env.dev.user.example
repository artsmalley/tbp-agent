# Copy this file to env/.env.dev.user and fill in the key for the provider you chose
# in env/.env.dev. The .user file is gitignored; never commit it.
# Keys prefixed SECRET_ are masked in Microsoft 365 Agents Toolkit logs.

# Option A — Claude (direct Anthropic key, or the key from your Azure AI Foundry resource)
SECRET_ANTHROPIC_API_KEY=

# Option B — Azure OpenAI
SECRET_AZURE_OPENAI_API_KEY=
