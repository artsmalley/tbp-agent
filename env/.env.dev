# Environment file for the "dev" environment. Committed to git by convention of the
# Microsoft 365 Agents Toolkit; keys and secrets go in env/.env.dev.user (gitignored).
#
# Fill in the two Azure values below, then run provision. The toolkit writes the
# generated values (BOT_ID, TEAMS_APP_ID, app service resource id, domain, tenant ids)
# into this file itself.

# Built-in environment variables
TEAMSFX_ENV=dev
# Appended to the Teams app name. Blank gives "TBP Coach"; set to e.g. " (pilot)" for a test install.
APP_NAME_SUFFIX=

# Your Azure subscription and the resource group the bot will be provisioned into.
# RESOURCE_SUFFIX must be unique-ish; it is appended to globally named resources.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=rg-tbp-coach
RESOURCE_SUFFIX=

# Generated during provision — leave blank, the toolkit fills them in.
BOT_ID=
TEAMS_APP_ID=
BOT_AZURE_APP_SERVICE_RESOURCE_ID=
BOT_DOMAIN=
TEAMS_APP_TENANT_ID=
BOT_TENANT_ID=
M365_TITLE_ID=
M365_APP_ID=

# Model configuration. Pick ONE provider (see README, "Choose a model provider").
# Every variable below must exist, even if blank — the toolkit fails on missing names.
# Keys go in env/.env.dev.user (copy env/.env.dev.user.example).
#
# MODEL_PROVIDER is "anthropic" or "azure-openai".
MODEL_PROVIDER=anthropic

# Option A — Claude, direct from Anthropic or via Microsoft Foundry.
# Foundry hosting and data-processing terms depend on your deployment; see README.
# For Foundry, the base URL is https://<resource>.services.ai.azure.com/anthropic.
# For api.anthropic.com, leave ANTHROPIC_BASE_URL blank.
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_BASE_URL=

# Option B — an Azure OpenAI deployment in your tenant (set MODEL_PROVIDER=azure-openai).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
